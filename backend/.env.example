# PRISM Backend Environment Configuration

# Service Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# Allowed Frontend Origins for CORS (comma-separated, trailing slashes automatically stripped)
# Always retain localhost origins for local preview / testing
CORS_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Storage and Database Configuration
DATABASE_URL=sqlite:///./prism.db
STORAGE_DIR=./storage/uploads

# Cryptographic Session Security (Generate a secure random string for production)
SECRET_KEY=prism-production-secret-key-replace-with-secure-value
SESSION_EXPIRY_HOURS=24
