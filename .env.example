# PRISM Unified Environment Configuration Template

# ==========================================
# 1. LOCAL DEVELOPMENT SETTINGS
# ==========================================
# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./prism.db
STORAGE_DIR=./storage/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SECRET_KEY=prism-hackathon-demo-secret-key-change-in-production
SESSION_EXPIRY_HOURS=24

# Frontend (optional for local dev: if left blank, Vite proxies /api to 127.0.0.1:8000)
VITE_API_URL=http://localhost:8000

# ==========================================
# 2. PRODUCTION SETTINGS (Vercel & Render)
# ==========================================
# In Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://<your-render-backend>.onrender.com

# In Render Web Service > Environment Variables:
# CORS_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:5173
# SECRET_KEY=<generate-a-secure-random-32-byte-hex-string>
# DATABASE_URL=sqlite:///./prism.db
# STORAGE_DIR=./storage/uploads
# SESSION_EXPIRY_HOURS=24
