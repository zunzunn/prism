# CREDEN Platform - Root Environment Configuration

# Backend Configuration
PROJECT_NAME="CREDEN AICTE Verification Platform"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-a-secure-random-key-here
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL default, SQLite fallback supported in dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/creden

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
